{
  "name": "pi-secretary",
  "version": "0.1.0",
  "description": "A personal pi coding agent extension.",
  "license": "MIT",
  "author": "WeZZard",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeZZard/pi-secretary.git"
  },
  "homepage": "https://github.com/WeZZard/pi-secretary#readme",
  "bugs": {
    "url": "https://github.com/WeZZard/pi-secretary/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@xterm/headless": "6.0.0",
    "typebox": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/**/*.test.ts",
    "test:serial": "node --experimental-strip-types --test --test-concurrency=1 tests/**/*.test.ts",
    "test:subagents": "node --experimental-strip-types --test --test-concurrency=1 tests/agents/*.test.ts",
    "test:acceptance": "node --experimental-strip-types --test --test-concurrency=1 tests/acceptance/*.test.ts",
    "record:tui": "python3 scripts/record-agent-tui.py",
    "render:tui": "node --experimental-strip-types scripts/render-tui-recording.ts",
    "lint:acceptance": "node --experimental-strip-types scripts/check-acceptance.ts",
    "lint:mermaid": "mmlint $(find docs -name '*.md' -type f | sort)",
    "verify": "npm run check && npm run test && npm run lint:mermaid && npm run lint:acceptance"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
