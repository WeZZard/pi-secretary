{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["extensions/secretary/computer-use/viewer/main.ts", "extensions/secretary/computer-use/viewer/behaviour.ts"]
}
